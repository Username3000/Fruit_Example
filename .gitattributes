# Keep text portable. Store binary files directly in Git.
* text=auto eol=lf
# Windows tooling uses CRLF in the working tree.
*.ini text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.uasset binary -filter
*.umap binary -filter
*.ubulk binary -filter
*.uexp binary -filter
*.uptnl binary -filter
*.fbx binary -filter
*.blend binary -filter
*.glb binary -filter
*.png binary -filter
*.jpg binary -filter
*.jpeg binary -filter
*.tga binary -filter
*.psd binary -filter
*.tif binary -filter
*.tiff binary -filter
*.exr binary -filter
*.hdr binary -filter
*.wav binary -filter
*.mp3 binary -filter
*.ogg binary -filter
*.mp4 binary -filter
*.zip binary -filter
*.7z binary -filter
